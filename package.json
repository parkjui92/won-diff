{
  "name": "won-diff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "한국어 예산표의 단위를 맞추고 실제 금액 변경을 검토하는 로컬 도구",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-cli.mjs && node scripts/build-standalone.mjs && node scripts/build-doc-assets.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "bench": "node --import tsx benchmarks/run.ts",
    "cli": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "papaparse": "5.5.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.19.0",
    "@types/papaparse": "^5.3.16",
    "daff": "1.4.2",
    "esbuild": "^0.25.12",
    "fast-check": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
